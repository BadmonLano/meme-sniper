# Meme Sniper: the single settings template. Copy to bots/.env and fill in.
# The setup wizard (python bots/sniper.py) and setup.json write the same file.
#
# Rules: never commit bots/.env. Values here are blank or defaults; no real keys, IDs or handles.
# Lines that start with "# KEY=" are optional knobs shown with their built-in default:
# remove the "# " to change one. Active lines below already equal the built-in default.
# Prices for the services below: SETUP.md section 0.1.

# ===== Agent autonomy (asked FIRST in setup) =====
# suggest (default): the agent proposes every buy and sell and waits for your OK
#   (/approve <id> via owner commands, or `python bots/approve.py <id>`); nothing trades until you approve.
# auto: WARNING - the agent buys and sells real funds on its own inside the caps below, with no
#   per-trade sign-off. Only pick auto if you accept that. Bot-armed SL/TP exits run in both modes.
AGENT_MODE=suggest
# AGENT_MODE_APPROVAL_TTL_MIN=60  # an unanswered suggestion expires after this many minutes

# ===== Trading wallet (live trading only; paper mode needs no private key) =====
# Make a NEW burner wallet in any Solana wallet app and export its private key. Fund it only with what you can lose.
# base58 private key of the burner trading wallet. Sign up: none, create it in a Solana wallet app
HOT_WALLET_PRIVATE_KEY=
# public address of that same wallet. Sign up: none
HOT_WALLET_ADDRESS=
# PRIVATE_KEY=  # legacy alias for HOT_WALLET_PRIVATE_KEY, read only if that is blank. Leave unset
# WALLET_ADDRESS=  # legacy alias for HOT_WALLET_ADDRESS (warden, console). Leave unset
# cold wallet that receives profit sweeps; blank = sweeps off. Captured once at start; a change needs a restart. Sign up: none, any wallet you control
LEDGER_ADDRESS=
# comma list of deposit-only addresses that may fund the trading wallet (inputs only; LEDGER_ADDRESS stays the only sweep output). Optional. Sign up: none
LEDGER_FUNDING_SOURCES=
# observer wallet the wallet tracker polls read-only for history (never trades from it). Optional. Sign up: none
OWNER_WALLET_ADDRESS=
# optional separate creator wallet for token launches; blank = use HOT_WALLET_PRIVATE_KEY. Sign up: none
LAUNCH_WALLET_PRIVATE_KEY=

# ===== RPC (required) =====
# Sign up at https://www.helius.dev (free tier to start; see SETUP.md 0.1 for plans) or use any Solana RPC provider.
# paid/primary Solana RPC URL, e.g. https://mainnet.helius-rpc.com/?api-key=<key>. Sign up: helius.dev or any RPC provider
RPC_URL=
# Helius key (warden, launch rail, enhanced APIs); optional if RPC_URL already carries ?api-key=. Sign up: helius.dev dashboard
HELIUS_API_KEY=
# optional second paid RPC, used when the primary fails sends. Sign up: any RPC provider
RPC_URL_FALLBACK=
# RPC_PUBLIC_FALLBACK=https://api.mainnet-beta.solana.com  # free public mainnet RPC, last resort. No sign-up
# RPC_FREE_URL=  # free RPC for non-trade reads; unset = RPC_PUBLIC_FALLBACK. No sign-up
# RPC_FREE_TIER=true  # true = throttle reads for a free-tier RPC
# RPC_READS_FREE_FIRST=true  # true = send read calls to the free RPC first to save paid credits
# RPC_PAID_METHODS=sendTransaction,getBalance,getTokenAccountsByOwner,getLatestBlockhash,getSignatureStatuses,simulateTransaction  # methods that always use the paid RPC
# RPC_INDEXED_METHODS=getTokenLargestAccounts,getTokenAccountsByOwner,getProgramAccounts  # methods that need an indexed (paid) RPC
# RPC_FREE_MAX_CONCURRENT=2  # max parallel calls to the free RPC
# RPC_FREE_MIN_INTERVAL_S=0.25  # min seconds between free-RPC calls
# RPC_FAILOVER_COOLDOWN_S=120  # seconds a failed RPC is skipped
# RPC_UNHEALTHY_FAILS=5  # consecutive failures before an RPC is marked unhealthy
# RPC_SIG_CACHE_TTL_S=20  # signature-status cache seconds
# SNIPER_RPC_MAX_CONCURRENT=3  # max parallel paid-RPC calls from the engine
# SNIPER_RPC_MIN_INTERVAL_S=0.14  # min seconds between paid-RPC reads
# SNIPER_RPC_SEND_MIN_INTERVAL_S=1.05  # min seconds between sendTransaction calls
# TX_MAX_VERSION=1  # max supported transaction version when reading txs
# Helius plan -> daily credit cap (the setup wizard asks your plan and sets this; SETUP.md 0.2).
# Free (1M/mo) 30000 | Developer ($49, 10M) 300000 | Business ($499, 100M) 3000000 | any number | 0 = off (no protection).
# Unset = Free cap 30000. Near the cap background reads slow down; trades and wallet reads never do.
# HELIUS_DAILY_CREDIT_CAP=
# HELIUS_CAP_MODE=soft  # soft (restrict at SOFT_PCT) | hard (restrict at 100%) | log
# HELIUS_SOFT_CAP_PCT=80  # percent of the cap where soft mode starts restricting
# HELIUS_WS_CREDITS_PER_MB=20  # credit estimate per MB of websocket data
# HELIUS_CREDIT_COSTS={}  # JSON overrides, e.g. {"getTransaction":1,"enhanced":100}
# HELIUS_ENHANCED_FALLBACK=false  # true = use Helius enhanced APIs when the raw path fails
# HELIUS_ENHANCED_DAILY_MAX=10  # max enhanced-API calls per day
# TX_CACHE_ENABLED=true  # confirmed transactions cached on disk (bot_logs/tx_cache.sqlite); same data, fewer RPC calls
# TX_CACHE_MAX_ROWS=20000  # oldest rows pruned past this
# RAW_TX_HELIUS_FALLBACK=false  # routine tx lookups (hold-time, wallet swaps, sent-back) read the free RPC only; true = old per-tx Helius fallback
# RAW_TX_GTFA_FALLBACK=true  # when the free RPC misses several, ONE Helius getTransactionsForAddress call (10 credits/100 txs) fills the cache
# RAW_TX_GTFA_MIN_MISS=3  # misses in one batch before that call is made
# RAW_TX_GTFA_LIMIT=100  # txs per getTransactionsForAddress call (max 100 = one 10-credit page)

# ===== Brain / models (one provider required; Grok recommended) =====
# Any provider works. Order = first answer wins. See SETUP.md section 5.
# Main brain: grok / openai / anthropic / ollama / openai_compat. Only the main and the fallback run;
# every other provider is OFF even if its key is set below.
LLM_MAIN=grok
# Fallback brain: same list, or none. Ollama cloud stays an opt-in under ollama (OLLAMA_CLOUD_ENABLED).
LLM_FALLBACK=ollama
# Legacy, used only while LLM_MAIN is unset: text / image brain order, comma lists. Code default grok,ollama
LLM_PROVIDER_ORDER=grok,ollama
VISION_PROVIDER_ORDER=grok,ollama
# xAI key. Sign up: https://console.x.ai
GROK_API_KEY=
# XAI_API_KEY=  # alias for GROK_API_KEY. Leave unset
# Grok text model; auto = newest from the daily auto-pick. Engine code default auto
GROK_TEXT_MODEL=grok-4.7
# GROK_VISION_MODEL=auto  # Grok vision model; auto = newest auto-picked
# XAI_MODEL=grok-4.7  # model the warden uses for its Grok calls
# GROK_API_BASE=https://api.x.ai/v1  # xAI API base URL
# GROK_REASONING_EFFORT=none  # reasoning effort sent to Grok
# GROK_TEXT_TIMEOUT=45  # seconds per Grok text call
# GROK_VISION_TIMEOUT=60  # seconds per Grok vision call
# GROK_VISION_MAX_TRIES=3  # retries per vision call
# GROK_COOLDOWN_SECONDS=600  # pause after Grok errors before retrying
# GROK_MODELS_CACHE_FILE=  # model auto-pick cache; unset = bot_logs/ default
# NARRATIVE_LLM_PRIMARY=grok  # narrative reads: grok = Grok first, Ollama fallback; ollama = the reverse
# OVERSEER_GROK_MODEL=  # model for the nightly overseer; unset = GROK_TEXT_MODEL
# OVERSEER_FALLBACK_MODEL=qwen3:14b-q4_K_M  # local Ollama model if the overseer's Grok call fails
# set from LLM_MAIN / LLM_FALLBACK when LLM_MAIN is set (ollama chosen = on). Legacy: true = use local Ollama
OLLAMA_ENABLED=false
# OLLAMA_URL=http://localhost:11434  # local Ollama URL
# OLLAMA_BASE_URL=http://localhost:11434  # same, read by x_intel
# OLLAMA_HOST=http://127.0.0.1:11434  # same, read by code_tuner
# local text model (ollama pull qwen3:14b-q4_K_M)
OLLAMA_MODEL=qwen3:14b-q4_K_M
# local vision model (ollama pull qwen2.5vl:7b)
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# OLLAMA_MEETING_MODEL=mistral-nemo:latest  # local model for code_tuner meetings
# OLLAMA_MEETING_FALLBACK_MODEL=qwen3:14b-q4_K_M  # fallback local model for meetings
# OLLAMA_TIMEOUT=120  # seconds per local text call
# OLLAMA_VISION_TIMEOUT=180  # seconds per local vision call
# OLLAMA_CONCURRENCY=1  # parallel local text calls
# OLLAMA_VISION_CONCURRENCY=1  # parallel local vision calls
# Ollama cloud, off by default; tried after Grok and local Ollama
OLLAMA_CLOUD_ENABLED=false
# Ollama cloud key. Sign up: https://ollama.com (account settings)
OLLAMA_CLOUD_API_KEY=
# Ollama cloud model
OLLAMA_CLOUD_MODEL=deepseek-v4-pro:cloud
# OLLAMA_CLOUD_URL=https://ollama.com  # Ollama cloud base URL
# OLLAMA_CLOUD_TIMEOUT=60  # seconds per Ollama cloud call
# OpenAI key. Sign up: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenAI text model; pick a current one, blank = OpenAI off
OPENAI_MODEL=
# OpenAI vision model; blank = OPENAI_MODEL
OPENAI_VISION_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1  # OpenAI API base URL
# Anthropic key. Sign up: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Claude text model; pick a current one, blank = Claude off
ANTHROPIC_MODEL=
# Claude vision model; blank = ANTHROPIC_MODEL
ANTHROPIC_VISION_MODEL=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1  # Anthropic API base URL
# any OpenAI-compatible endpoint, e.g. https://host/v1. Sign up: your host
OPENAI_COMPAT_BASE_URL=
# its key, if it needs one. Sign up: your host
OPENAI_COMPAT_API_KEY=
# its text model
OPENAI_COMPAT_MODEL=
# its vision model (if it takes images)
OPENAI_COMPAT_VISION_MODEL=
# VISION_CACHE_FILE=  # vision result cache; unset = bot_logs/ default

# ===== Token launches (launch rail) =====
# OFF-CHAIN BY DEFAULT: LAUNCH_RAIL_LIVE=0 keeps every launch a dry run. Set LAUNCH_RAIL_LIVE=1 to let the agent create tokens, dev-buy, burn and claim fees with real SOL, without asking unless rules/rules.md says to ask.
# master switch (ships OFF; set 1 to turn on; also settable in bot_logs/launch_rail_config.json)
LAUNCH_RAIL_ENABLED=false
# 0 = simulate only (default), 1 = launches go on-chain. The wizard asks
LAUNCH_RAIL_LIVE=0
# dev-buy cap per launch in SOL (CLI --max-dev-buy wins, then this, then config)
LAUNCH_MAX_DEV_BUY_SOL=0.5
# IPFS uploads for token image + metadata. Sign up: https://pinata.cloud (free plan), API Keys > New Key > copy the JWT
PINATA_JWT=
# 1 = mock IPFS uploads (testing only)
LAUNCH_RAIL_NO_UPLOAD=0
# optional: load launch secrets from a different env file
LAUNCH_ENV_FILE=
# optional: higher GitHub API rate limit for the repo check. Sign up: https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=

# ===== Own launches (tokens this system launched) =====
# No sign-up needed for anything in this section.
# hold = keep OWN_LAUNCH_TREASURY_PCT back; flip = everything sellable. Default hold
OWN_LAUNCH_MODE=hold
# multiple:percent-of-sellable, armed one rung at a time
OWN_LAUNCH_TP_LADDER=2x:25,5x:25,10x:25
# off, or a stop-loss percent on the sellable side
OWN_LAUNCH_SL_PCT=off
# portion kept back (still on the holdings ledger; sell_holding fraction 1.0 exits all). Default 0
OWN_LAUNCH_TREASURY_PCT=0
# off | burn (lock/vesting not supported yet)
OWN_LAUNCH_LOCK_MODE=off
# percent of the dev bag to burn when LOCK_MODE=burn
OWN_LAUNCH_BURN_PCT=0
# creator-fee claim interval (hours)
OWN_LAUNCH_FEE_CLAIM_H=24
# own-launch card / ladder check interval (seconds)
OWN_LAUNCH_CHECK_S=120
# how often a card packet goes to the inbox (hours)
OWN_LAUNCH_CARD_INBOX_H=6

# ===== Owner sizes, default exits and learning mode =====
# Written by the setup wizard. No sign-up needed. Unset (or 0) = the engine behaves as before.
# Each key is copied into the filter knob of the same name in bots/tuner/meme_sniper_filter.json within ~30s
# whenever its value HERE changes; the knob is what the engine uses, and the agent, Settings and learning mode
# can tune it there (SETUP.md section 4.1). Hard safety caps (MIN_BUY_SOL floor, wallet floor, PROTECT_* bounds) always apply.
# SNIPER_BUY_SIZE_SOL=  # base buy size in SOL: replaces SIZE_CAP_BASE_SOL as the base entry cap (tier ladder scaled down to match) and is used when a buy signal has no amount. Wizard default 0.1
# SNIPER_DEFAULT_SL_PCT=  # stop-loss % armed on each new position when the agent's buy sets none. Wizard default 25
# SNIPER_DEFAULT_TP_PCT=  # take-profit % armed on each new position when the agent's buy sets none. Wizard default 100
# SNIPER_LEARNING_MODE=0  # 1 = learning mode: start small, adjust size and SL/TP from closed trades in small logged steps. Default 0 (off)
# SNIPER_LEARN_REST=true  # with learning mode on, also invite the agent to tune the other filters from the same results
# SNIPER_LEARN_COOLDOWN_H=24  # rest between learning adjustments (hours)
# SNIPER_LEARN_MIN_TRADES=10  # closed trades needed since the last adjustment
# SNIPER_LEARN_STEP_PCT=10  # largest change to one value in one step (percent)
# SNIPER_LEARN_TICK_S=600  # how often learning mode checks (seconds)
# SNIPER_LEARN_START_SIZE_SOL=0.1  # conservative start size when learning starts with no buy size set (never below MIN_BUY_SOL)
# SNIPER_LEARN_START_SL_PCT=20  # conservative start stop-loss when none is set
# SNIPER_LEARN_START_TP_PCT=60  # conservative start take-profit when none is set

# ===== Paper mode (ON by default; live is opt-in) =====
# On: the full pipeline runs, but buys and sells are simulated at real Jupiter quotes with estimated slippage and fees,
# no transaction is sent, launches are dry runs, and trade state goes to bot_logs/paper/. Read at start: restart to switch.
# Leaving paper for live needs an explicit confirm (wizard / Settings: type LIVE; setup.json: SNIPER_CONFIRM_LIVE=LIVE).
# 1 = paper trading (default for new setups). 0 = live: only after you add the wallet key and confirm LIVE.
SNIPER_PAPER_MODE=1
# SNIPER_PAPER_START_SOL=1.0  # paper wallet starting balance (SOL)
# SNIPER_PAPER_SLIPPAGE_PCT=1.0  # extra slippage taken off every paper fill, on top of the quote's price impact
# SNIPER_CONFIRM_LIVE=  # setup.json only: must be LIVE to switch SNIPER_PAPER_MODE from 1 to 0; never stored in .env

# ===== League mode (AudaceFi devnet league; OFF by default) =====
# Off: nothing league-related runs and the mainnet path is unchanged. Placeholders only: no keys ship here.
# LEAGUE_MODE=false
# LEAGUE_RPC_URL=  # devnet RPC (boot refuses mainnet)
# LEAGUE_WALLET_ADDRESS=  # separate league wallet (refused if it matches the main wallet)
# LEAGUE_WALLET_KEYPAIR_PATH=  # or LEAGUE_WALLET_PRIVATE_KEY=; never the main wallet key
# LEAGUE_WALLET_PRIVATE_KEY=
# LEAGUE_USDC_MINT=  # the league's devnet USDC mint
# LEAGUE_ALLOWLIST_FILE=  # JSON list of allowed mints; no list = no league buys
# LEAGUE_CATEGORY=degen
# LEAGUE_SEASON_START=  # blank = Mon 00:00 UTC
# LEAGUE_SEASON_END=  # blank = Sat 00:00 UTC
# LEAGUE_FLATTEN_BUFFER_MIN=120
# LEAGUE_BUY_USDC=25
# LEAGUE_MAX_BUY_USDC=100
# LEAGUE_GAS_MIN_SOL=0.02
# LEAGUE_EXECUTOR_MODULE=  # AudaceFi supported-API executor module; unset = league trades refused
# LEAGUE_SKIP_GENESIS_CHECK=false

# ===== Alerts (optional; SETUP.md section 6) =====
# Where owner alerts go. Comma list of: telegram, discord, email, ntfy   (or off)
# Blank = telegram when TELEGRAM_TOKEN + TELEGRAM_CHAT_ID are set, else no alerts. Telegram is not required.
# iMessage is planned for the Mac version and is not available yet.
ALERT_CHANNELS=
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL. Secret.
DISCORD_WEBHOOK_URL=
# Email (SMTP). Port 587 = STARTTLS, 465 = SSL. Gmail: smtp.gmail.com + an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address (blank = SMTP_USER) and where alerts go
SMTP_FROM=
ALERT_EMAIL_TO=
# 1 = upgrade to TLS on 587 (default), 0 = plain (only for a local relay)
SMTP_STARTTLS=1
# Seconds between alert emails; alerts inside the window are counted and noted in the next email
ALERT_EMAIL_MIN_INTERVAL_S=60
# ntfy (phone push, https://ntfy.sh or your own server). Pick a long unguessable topic name.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
# Only for access-protected topics
NTFY_TOKEN=

# ----- Telegram (one alert channel) -----
# Sign up: in Telegram message @BotFather, send /newbot, copy the token. Chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates or @userinfobot. See SETUP.md section 6.
# bot token from @BotFather
TELEGRAM_TOKEN=
# chat or group ID for alerts (groups start with -)
TELEGRAM_CHAT_ID=
# Backup alert bot token (optional): a second Telegram bot the warden sends alerts through. Use it if another app
# or agent already polls your main bot (Telegram allows one poller per bot). Blank = the main token. Same chat ID.
# The warden only sends; it does not read commands. Create it with @BotFather like the main bot (SETUP.md section 6).
X_NOTIFY_TELEGRAM_TOKEN=

# ===== Owner commands (optional, off by default; SETUP.md section 6.5) =====
# Ask the agent on demand: /roast, /recap, /autopsy [ticker|last], or plain text ("roast me").
# off = nothing runs (default). telegram = a SEPARATE command bot reads only your chat.
# file = drop a .txt or .json into owner_commands/ (any OS, no Telegram); replies go to your alert channels.
# Every reply is also saved in inbox_results/owner_replies/. It never trades or changes settings.
OWNER_COMMANDS=off
# telegram mode only: a second @BotFather bot. Never TELEGRAM_TOKEN or X_NOTIFY_TELEGRAM_TOKEN
# (it refuses those, and stops on a 409 if anything else already polls it).
OWNER_COMMANDS_TG_TOKEN=
# telegram mode only: the chat it answers (blank = TELEGRAM_CHAT_ID). Messages from other chats are ignored.
OWNER_COMMANDS_TG_CHAT_ID=
# seconds between SI-judged /roast or /recap answers (/autopsy has no cooldown)
OWNER_ROAST_COOLDOWN_S=900
# on = your trades roast you, the agent's roast the agent; off = always roast the agent
OWNER_ROAST_TARGETING=on

# ===== Owner positions (SETUP.md section 6.6) =====
# A bag in the wallet the bot did not buy is asked about before it is managed. true = on (default).
OWNER_POS_ENABLED=true
# minutes to wait for /manage or /leave before the bot manages it with its normal flip exits
OWNER_POS_TIMEOUT_MIN=30
# bags worth less than this (USD) are not asked about
OWNER_POS_MIN_USD=10
# off = positions the bot takes over (manage or timeout) skip the max-hold time exit: SL, TP and trail only. on = normal time exit
OWNER_POS_TIME_EXIT=off
# minutes between light owner-position checks (one token-account call each), on top of the 30-min holdings sweep
OWNER_POS_SCAN_MIN=5

# ===== Clone runner (SETUP.md section 6.7) =====
# A non-canonical clone that clearly outpaces the canonical gets its own "Clone Running" card instead of being folded or suppressed. No buy bypass. on = on (default).
CLONE_RUNNER_ENABLED=on
# clone volume must be at least this many times the canonical's (1h volume when both have it, else 24h)
RUNNER_VOL_RATIO=3
# minutes the clone must keep outpacing the canonical (and have more liquidity) before it is promoted
RUNNER_SUSTAIN_MIN=60

# ===== X: browser scraper and x_intel (optional) =====
# Scraper: no key; sign in once with launcher menu option 3 (SETUP.md section 9). x_intel: X API keys from https://developer.x.com (Projects & Apps > your app > Keys and tokens).
# app bearer token for x_intel keyword search; blank = search skipped (logs no_bearer). Sign up: developer.x.com
X_BEARER_TOKEN=
# OAuth 2.0 client ID, only for reading the account's bookmarks/likes. Sign up: developer.x.com
X_CLIENT_ID=
# OAuth 2.0 client secret (same app)
X_CLIENT_SECRET=
# numeric ID of the X account whose bookmarks/likes are read
X_USER_ID=
# OAuth 2.0 user access token; x_intel rewrites this line when it refreshes
X_INTEL_TOKEN=
# OAuth 2.0 refresh token; x_intel rewrites this line
X_INTEL_REFRESH_TOKEN=
# X_INTEL_MAX_SEARCHES=20  # max X searches per scan
# X_INTEL_NOISE_RESERVED=6  # searches reserved for the noise lane
# X_INTEL_PHASE2_ENABLED=false  # true = run the parked sustained-emotion pass
# X_NOISE_MAX_DYNAMIC_TICKERS=3  # extra tickers the noise lane tracks
# X_NOISE_TWEETS_PER_TICKER=30  # tweets read per ticker
# X_NOISE_LLM_MODEL=mistral-nemo  # local model that scores noise
# X_NOISE_LLM_BATCH_SIZE=15  # tweets per scoring batch
# X_NOISE_LLM_TIMEOUT=60  # seconds per local scoring call
# X_NOISE_GROK_TIMEOUT=45  # seconds per Grok scoring call
# AGENT_SCRAPER_HEADLESS=false  # true = fully hidden browser; default runs a minimized window
# BROWSER_USER_DATA_DIR=  # opt-in: use another Chrome user-data dir for X; unset = bots/scraper_profile/ (recommended)
# X_VERIFY_MAX_AGE_H=24  # hours a logged-in X page counts as 'Connected (verified)'
# BROWSER_PROFILE_NAME=Profile 1  # profile name inside that folder

# ===== Other data APIs (optional) =====
# Each is optional; blank = that feature is skipped.
# Jupiter swap API key for higher limits. Sign up: https://portal.jup.ag
JUPITER_API_KEY=
# JUPITER_BASE=https://api.jup.ag  # Jupiter API base URL
# true 1-minute candles for chart reads; blank = DexScreener candles. Sign up: https://bds.birdeye.so
BIRDEYE_API_KEY=
# coin-communities (pump.fun community) data. Sign up: check provider (api.coin-communities.xyz)
COINCOMMS_API_KEY=
# same provider, server key
COINCOMMS_SERVER_KEY=
# same provider, server secret
COINCOMMS_SERVER_SECRET=

# ===== Optional pipes (off by default) =====
# Both talk to services that are not in this repo. Leave at 0 unless the owner runs one (SETUP.md section 12). No sign-up.
# external market-regime feed. Default 0 (off)
PIPE_FLOW_ENABLED=0
# external deep/social research responder. Default 0 (off)
PIPE_RESEARCH_ENABLED=0
# FLOW_DATA_DIR=  # folder the flow feed writes to (only with PIPE_FLOW_ENABLED=1)

# ===== Launch feed (new tokens) =====
# PumpPortal's new-token feed is public: no key, no sign-up.
# LAUNCH_FEED=pumpportal  # pumpportal | helius | both
# PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data  # PumpPortal data websocket
# PUMPPORTAL_SUB_NEW_TOKENS=true  # subscribe to new tokens
# PUMPPORTAL_SUB_MIGRATIONS=true  # subscribe to migrations
# BIRTH_HELIUS_PROGRAMS=  # programs to keep on Helius, e.g. launchlab,meteora_dbc; default empty with LAUNCH_FEED=pumpportal
# BIRTH_PUMPSWAP_SUB=false  # subscribe to PumpSwap births
# LAUNCH_POLL_FALLBACK=free  # free | helius | off
# LAUNCH_REPLAY_ON_BOOT=false  # replay recent launches on start; default false with LAUNCH_FEED=pumpportal
# BIRTH_PENDING_RETRY_S=60  # seconds between retries of pending births
# BIRTH_PENDING_MAX=400  # max pending births held

# ===== Chains (plug-in point) =====
# Solana is the only chain that trades today. bots/chains/ holds the adapter interface and the
# Solana reference adapter (SETUP.md section 14). The engine does not route trades through it yet.
# CHAIN_ADAPTERS=solana  # comma list of adapters to load. Default solana
# Every other chain also needs its own switch, off by default: CHAIN_<NAME>_ENABLED=0 (e.g. CHAIN_BASE_ENABLED=0)

# ===== Protective orders and position checks =====
# No sign-up needed.
# POSITION_TICK_S=15  # seconds between position checks (also filter-overridable)
# PROTECT_ENFORCE=true  # true = every position must carry SL/TP
# PROTECT_SL_MIN_PCT=3  # smallest allowed stop-loss %
# PROTECT_SL_MAX_PCT=95  # largest allowed stop-loss %
# PROTECT_TP_MIN_PCT=5  # smallest allowed take-profit %
# PROTECT_MAX_RETRIES=5  # retries when an SL/TP sell fails
# PROTECT_EXEC_BUFFER_S=30  # seconds of grace before a protection fires
# PROTECT_STALE_MIN=60  # minutes before missing protection is flagged
# PROTECT_DIGEST_COLLAPSE=true  # collapse protection alerts into one digest
# PROTECT_DIGEST_PASSTHRU=dev_dump_detected,liq_drain  # alert types that skip the digest
# PANIC_PRIORITY_FEE_CAP_LAMPORTS=5000000  # max priority fee on panic sells (0.005 SOL); 0 = no cap
# AGENT_INBOX_CADENCE_S=300  # how often position packets go to the inbox
# POSITIONS_DIGEST_S=300  # positions digest interval; unset = AGENT_INBOX_CADENCE_S
# WALLET_PNL_ZERO_GUARD_SOL=0.0005  # PnL below this counts as zero
# TREASURY_MTM_SUMMARY_HOUR=21  # hour (ET) of the daily treasury mark-to-market summary

# ===== Scanner and forensics =====
# No sign-up needed.
# BUY_CARD_AGE_FLAG_MIN=10  # flag a buy made from a card older than this (minutes; flag only)
# EARLY_MORNING_WARN_HOURS=3-8  # local hours start-end (end exclusive) in which a buy gets an early-morning flag; flag only, never blocks
# VIBES_WARN_ENABLED=true  # flag buys whose reasoning cites no data (flag only)
# MISSED_RUNNER_MAX_RATIO=50  # missed-runner detector: max price ratio
# MISSED_RUNNER_MIN_SCAN_MCAP=3000  # missed-runner detector: min mcap at scan
# MISSED_RUNNER_MAX_MCAP=500000000  # missed-runner detector: max mcap
# INBOX_DUPE_WINDOW_S=900  # drop duplicate packets inside this window
# INBOX_DIGEST_EXTRA_TYPES=signal_rejected,protection_missing  # packet types folded into digests
# LIQ_RECARD_MIN_USD=5000  # liquidity at which a zero-liquidity token is re-checked and recovered
# LZRC_MAX_QUEUE=60  # max tokens in the heal-watch queue
# EDGE_LIQ_MIN_USD=20000  # edge band: min liquidity
# EDGE_LIQ_MAX_USD=50000  # edge band: max liquidity
# CARD_THIN_LIQ_USD=1000  # liquidity under this is marked thin on cards
# BRAND_DEAD_OG_LIQ=10000  # dead-OG check: liquidity floor
# BRAND_DEAD_OG_VOL_24H=5000  # dead-OG check: 24h volume floor
# CLONE_FLOOD_TICKER_COOLDOWN_S=21600  # cooldown per ticker during clone floods
# OBSERVE_MAX_PER_TICKER_HOUR=3  # max observer subscriptions per ticker per hour
# DEX_MAX_RPM=50  # DexScreener calls per minute
# DEX_PAIRS_MAX_RPM=240  # DexScreener pairs calls per minute
# DEX_MAX_CONCURRENT=2  # parallel DexScreener calls
# HOLD_TIME_CACHE_S=1800  # holder hold-time cache seconds (kept in bot_logs/hold_time_cache.json across restarts)
# HOLDTIME_MAX_PER_HOUR=20  # max hold-time lookups per hour
# HOLDTIME_RAW_MAX_TX=60  # max txs read per hold-time lookup
# RAW_SENTBACK_MAX_TX=20  # max txs read for sent-back checks
# FUNDER_CACHE_MAX=5000  # funder map cache size
# FUNDER_MAP_NONE_RETRY_S=86400  # retry an empty funder lookup after this
# RELAY_RESPONSE_TTL_HOURS=6  # relay response file TTL
# RELAY_FAILED_TTL_HOURS=1  # relay failed file TTL

# ===== Ranking (KOLs, devs, callers) =====
# No sign-up needed.
# RANK_WINDOWS_H=1,6,24  # outcome windows (hours)
# RANK_SCORE_WINDOW_H=6  # window used for the score
# RANK_WIN_PCT=30  # gain % that counts as a win
# RANK_MIN_CALLS=5  # calls before an entity is ranked
# RANK_RUG_LIQ_USD=1000  # liquidity under this = rug
# RANK_RUG_DROP_MULT=0.2  # price drop multiple that = rug
# RANK_RUG_RATE_BAD=0.5  # rug rate that marks a rugger
# RANK_T1_HIT=50  # tier 1 hit rate %
# RANK_T1_AVG=50  # tier 1 average gain %
# RANK_T2_HIT=35  # tier 2 hit rate %
# RANK_T3_HIT=20  # tier 3 hit rate %
# RANK_PRUNE_MIN_CALLS=10  # prune entities under this many calls
# RANK_STALE_DAYS=60  # drop entities idle this long
# RANK_OUTCOME_LOOP_S=300  # outcome loop interval
# RANK_FETCH_PER_CYCLE=80  # outcomes fetched per cycle
# RANK_MAX_CALLS_PER_ENTITY=100  # calls kept per entity
# RANK_MAX_ENTITIES=20000  # entities kept
# RANK_DEV_TRACK=true  # rank devs too
# RANK_TIER_WEIGHTS={}  # JSON tier weights, built-in {"T0":10,"T1":7,"T2":4,"T3":2,"T4":1,"unproven":1,"rugger":-5}
# KOL_AUTO_APPLY=true  # apply ranking changes to the KOL list automatically

# ===== Wallet tracker =====
# No sign-up needed.
# WALLET_OWNER_RESOLVE=true  # resolve token accounts to owner wallets
# WALLET_INFRA_TOKEN_COUNT=40  # an owner seen on this many tokens is treated as a pool/program, not a trader
# WALLET_EXCLUDE_OWNERS=  # comma list of program authorities never tracked; built-in list (Raydium AMM v4, Raydium CPMM, Pump.fun migration) applies when unset
# WALLET_TRACK_REFRESH_S=7200  # tracked-wallet refresh interval
# WALLET_POLL_INTERVAL_S=180  # poll interval per tracked wallet
# WALLET_TRACKED_MAX=20  # max tracked wallets
# WALLET_GRADUATE_MIN_TOKENS=3  # tokens before a wallet graduates to tracked
# WALLET_SWAPS_CACHE_S=600  # wallet swap cache seconds
# RAW_WALLET_SWAPS_MAX_TX=30  # max txs read per wallet
# WALLET_BOT_FILTER=true  # skip wallets that trade like bots
# WALLET_BOT_BURST_BUYS=3  # buys inside WALLET_BOT_BURST_S that mark a bot
# WALLET_BOT_BURST_S=5  # burst window seconds
# WALLET_BOT_TINY_SELLS=6  # tiny sells that mark a bot
# WALLET_BOT_TINY_SELL_SOL=0.005  # what counts as a tiny sell

# ===== Sub-bots: warden, autoagent, code_tuner, log_janitor =====
# No sign-up needed.
# WARDEN_INTEGRITY_FILES=  # extra workspace-relative files the warden hashes for integrity (comma list)
# SNIPER_WATCH_INTERVAL_S=300  # warden sniper-watch interval
# SNIPER_STALE_ALERT_MIN=30  # alert when the engine heartbeat is older than this
# SNIPER_ZERO_BUY_ALERT_H=24  # alert after this many hours with no buys
# INBOX_CRON_LOCK_MAX_AGE_S=900  # automation lane locks older than this are reaped
# OVERSEER_SCHEDULED_HOUR_EST=2  # hour (ET) of the nightly autoagent run (name kept for compatibility)
# OVERSEER_SCHEDULED_MINUTE=0  # minute of that run
# AUTOAGENT_SIZING_LOOKBACK_H=168  # hours of trades the sizing review reads
# CODE_TUNER_HEARTBEAT_INTERVAL_S=60  # code_tuner heartbeat
# CODE_TUNER_MEETING_POLL_S=30  # meeting file poll
# CODE_TUNER_CONFIG_DRIFT_INTERVAL_S=600  # config drift check
# CODE_TUNER_METRICS_REFRESH_S=1800  # metrics refresh
# CODE_TUNER_REGISTRY_REFRESH_S=300  # registry refresh
# CODE_TUNER_SNAPSHOT_INTERVAL_S=1800  # snapshot interval
# CODE_TUNER_PERF_CYCLE_S=172800  # performance review cycle (48 h)
# CODE_TUNER_OLLAMA_TIMEOUT_S=60  # local model timeout for code_tuner
# JANITOR_DISK_GUARD_SECONDS=3600  # disk guard interval
# JANITOR_FREE_FLOOR_GB=5.0  # emergency clean below this free space
# AGENT_SESSION_DIRS=  # extra agent session folders the janitor may trim, separated by ; on Windows or : elsewhere

# ===== Launcher and console =====
# No sign-up needed.
# WORKSPACE_DIR=  # root folder; unset = the repo folder (SETUP.md section 3)
# SNIPER_COMPONENTS=  # comma list of components to start; unset = all
# SNIPER_UI=1  # 0 = plain status view instead of the console
# DASH_DEX_MIN_INTERVAL_S=30  # dashboard DexScreener refresh
# DASH_RPC_MIN_INTERVAL_S=120  # dashboard balance refresh (seconds)
# EDITOR=  # editor the console opens for skills (your OS default if unset)

# ===== Agent duties + clone handling (optional) =====
# Errors & oddities duty: the agent reports bugs as owner cards with a proposed patch;
# the owner applies it.
# Canonical clone pick: points a challenger must beat the held canonical by (default 10)
BRAND_CANON_HYSTERESIS=10
# Hours a held canonical stays held while missing from search results (default 6)
BRAND_CANON_STICKY_H=6
# Seconds a ticker cluster keeps its one inbox card for folding clones (default 7200)
CLONE_CLUSTER_WINDOW_S=7200

# ===== Post-close watch + miss cadence (optional; DexScreener only, no Helius) =====
# After every close the price is watched 1 min/30 min, 5 min/4h, 15 min to this many hours
POST_CLOSE_WATCH_H=24
# 'Sold too early' = price reached this % above our exit within the window below
SOLD_TOO_EARLY_PCT=30
SOLD_TOO_EARLY_WINDOW_H=4
# A missed runner reports at most once per this many seconds (analysis runs every 90 min)
MISSED_RUNNER_REPORT_COOLDOWN_S=14400
# Missed-runner observer: fast checks (s) for the first hours of a watch, then slow checks (s)
OBSERVER_FAST_TICK_S=300
OBSERVER_FAST_WINDOW_H=6
OBSERVER_SLOW_TICK_S=900

# ===== Names (optional) =====
# Filled into learnings/LEARNINGS.md ({AGENT_NAME}, {USER}) when learnings_writer creates it from the template.
# AGENT_NAME=
# OWNER_NAME=
# Hold benchmark file curated by the agent (ticker + CA required inside; see meme-hunter "Set a custom hold benchmark"),
# e.g. bot_logs/hold_benchmark.json. Blank, a bare ticker or an invalid file = $GORK (bot_logs/gork_standard.json).
# SNIPER_HOLD_BENCHMARK=

# ===== Market structure guards (Oct 2026; sniper_upgrades.py) =====
# pump.fun Custom Pairs (coins quoted in a non-SOL asset): flag | skip | off (default flag; card shows the quote)
CUSTOM_PAIR_ACTION=flag
# Negative / one-sided / unreadable reserves: skip (+ recheck later) | flag | off
RESERVE_GUARD=skip
# Meteora DAMM v2 / DBC pull-and-dump guard on NEW entries: skip | flag | off
METEORA_DRAIN_GUARD=skip
METEORA_DRAIN_LIQ_DROP_PCT=50
METEORA_DRAIN_DUMP_PCT=60
METEORA_DRAIN_ALL_VENUES=false
# Official xStocks list (api.xstocks.fi, cached 24h): marks real tokenized stocks, stock-meme pairs and fakes
XSTOCKS_CHECK=true
FAKE_XSTOCK_ACTION=flag
# Wash-volume heuristic (card flag only)
WASH_CHECK=true
WASH_VOL_LIQ_RATIO=40
WASH_AVG_TRADE_USD=1500
# Bundle signal: txs in the launch slot (card field). 1 RPC call per mint younger than the max age.
BUNDLE_CHECK=true
BUNDLE_CHECK_MAX_AGE_MIN=90
BUNDLE_FLAG_MIN_TX=4
# Fee sweep (CreatorFeesNotSwept): mint is rechecked after this many minutes, never written off
FEE_SWEEP_RECHECK_MIN=30
# Also match the numeric codes 6095/6081/6033 (from pump SDK docs, unverified against the program): default false
FEE_SWEEP_NUMERIC_CODES=false
# Jupiter Swap API V2 (/order + /execute, needs JUPITER_API_KEY). v1 stays the fallback. Jupiter manages
# slippage on V2, so SELL_SLIPPAGE caps do not apply to V2 fills. Default false.
JUPITER_SWAP_V2=false
# Moonshot (Moonit) launch listener. Program id from public IDL libraries, not Moonshot's docs. Default false.
MOONSHOT_LISTENER=false
MOONSHOT_POLL_S=60
MOONSHOT_MAX_TX=5

# ===== Trench News (runs inside Sniper automatically; no separate step) =====
# Every 3 days by default; the last run is remembered, so restarts never re-fetch early.
# Each change is fingerprinted and delivered once (owner alert + agent inbox packet).
# Alerts only when a change is officially announced AND landed (real 24h volume).
# auto = alert + queue a proposal for the agent | ask = alert and wait for you | off = log only
VENUE_ADAPT=ask
TRENCH_NEWS_ENABLED=true
TRENCH_NEWS_INTERVAL_S=259200
TRENCH_NEWS_MIN_VOLUME_USD=250000
TRENCH_NEWS_PENDING_DAYS=7

# Own launches + repo watch (meme_sniper)
# seconds between launch-request checks
SNIPER_LAUNCH_POLL_S=30
# GitHub user whose public events become repo_event inbox notes; blank = off
REPO_WATCH_USER=
REPO_WATCH_INTERVAL_S=420
# optional read-only GitHub token
REPO_WATCH_TOKEN=

# optional: GitHub sign-in for Sniper (OAuth Device Flow). Client ID of YOUR OAuth App (public, not a secret).
# Create at https://github.com/settings/developers -> New OAuth App -> tick 'Enable Device Flow'. Blank = no sign-in, username/link still work.
GITHUB_OAUTH_CLIENT_ID=
# optional GitHub helper knobs (sniper_github.py). Defaults shown in comments.
# 1 (default) = launches may skip the repo; 0 = repo required
LAUNCH_ALLOW_NO_REPO=
# suggestions per wallet/GitHub account per day (default 3)
SNIPER_SUGGEST_DAILY_CAP=
# agent name whose inbox gets review notes (default reviewer)
SNIPER_REVIEWER=
# 0 = don't watch repo_drops/ for uploads (default 1)
SNIPER_REPO_DROPS_WATCH=
# must be 1 (plus --owner-ok) before anything is pushed to GitHub
SNIPER_GH_PUSH_OK=

# ===== Safety caps + your settings (Oct 2026; README "Safety caps and your settings") =====
# Blank = default shown. 0 = off for numbers. Loosen only with the owner's OK.
# default 0.5 SOL realized loss per ET day, then no buys
DAILY_LOSS_STOP_SOL=
# default 10 buys per ET day
DAILY_BUY_CAP=
# default true: block live mint/freeze authority
BUY_AUTHORITY_GATE=
# default true: unreadable mint account = block
BUY_AUTHORITY_FAIL_CLOSED=
# default 50: skip if up more than this % in 5m
MAX_PUMP_5M_PCT=
# default 0 (off): hard max size per buy
OWNER_MAX_BUY_SOL=
# default true: 4+ rug sources unreachable = block
RUG_FAIL_CLOSED=
# default 4
RUG_FAIL_CLOSED_MIN_ERRORS=
# default true: dev holdings unreadable = no second-wind ping
RECLAIM_DEV_FAIL_CLOSED=
# default true: inbox floor (liquidity, wash, bundle)
CANDIDATE_FLOOR=
# default 10000
CANDIDATE_MIN_LIQ_USD=
# default blank (always). e.g. 09:00-23:00
TRADING_HOURS=
# default America/New_York
TRADING_TZ=
# default true: no new inbox cards outside the window
TRADING_HOURS_GATES_SCAN=
# default 3 losses in a row
LOSS_STREAK_PAUSE=
# default 2
LOSS_STREAK_PAUSE_HOURS=
# default 2
SIZE_HALVE_AFTER_LOSSES=
# default 3
MAX_OPEN_POSITIONS=
# default 72
MINT_COOLDOWN_HOURS=
# default true
SECOND_WIND_V2=
# default true: fresh price/liquidity/rug recheck right before every agent or manual buy
SIGNAL_RECHECK=
# default 10000: min liquidity (USD) at the recheck
SIGNAL_RECHECK_MIN_LIQ_USD=
# default 50: max market-cap move (%) since the signal
SIGNAL_RECHECK_MAX_DRIFT_PCT=
# default true: drift recheck uses mcap_at_signal from your buy signal when present
SIGNAL_RECHECK_USE_SIGNAL_MCAP=
# default true: a missing alert-channel key is warned once per run, not on every alert
ALERT_MISSING_WARN_ONCE=
# default true: first run copies bots/tuner/meme_sniper_filter.default.json to the (git-ignored) live filter file
SNIPER_FILTER_SEED_DEFAULT=
# default true: the setup wizard asks the Safety caps questions
SNIPER_WIZARD_SAFETY=
# default true: every agent action (signals, launches, wallet/archetype commands, repo suggestions and
# decisions, publish, owner commands, code_tuner setup/meeting, filter edits) gets a confirm_/failed_ memo in inbox/.
# Per kind: AGENT_MEMO_SIGNAL, AGENT_MEMO_LAUNCH, AGENT_MEMO_WALLET_COMMAND, AGENT_MEMO_ARCHETYPE_COMMAND,
# AGENT_MEMO_REPO_SUGGESTION, AGENT_MEMO_REPO_DECISION, AGENT_MEMO_PUBLISH, AGENT_MEMO_OWNER_COMMAND,
# AGENT_MEMO_CODE_TUNER_SETUP, AGENT_MEMO_CODE_TUNER_MEETING, AGENT_MEMO_SNIPER_MEETING, AGENT_MEMO_FILTER_EDIT (=0 = off)
AGENT_MEMOS=
# default true: also write success memos (false = failures only)
AGENT_MEMO_SUCCESS=
# default true: relay_ack success packets go to inbox/ (false = inbox_results/done/ only)
RELAY_ACK_SUCCESS_TO_INBOX=
# default true: an empty set_protection_batch is rejected with a reason (false = old silent ok)
PROTECTION_BATCH_EMPTY_REJECT=
# default true: the wizard ends with a reminder to schedule the inbox checks
SNIPER_WIZARD_REMINDER=
# default 80
SECOND_WIND_MAX_OFF_PEAK_PCT=
# default 30
SECOND_WIND_BASE_RANGE_PCT=
# default true
SECOND_WIND_SCORE=
# default true
PEAK_SANITY=
# default 1000
PEAK_SANITY_MAX_X=

# ── v1.0.3 fee-wallet vault exception (see README) ──
VAULT_EXCEPTION=true
VAULT_MIN_TRANSFER_PCT=20
VAULT_CREATOR_DONE_PCT=5
VAULT_CREATOR_QUIET_S=60
VAULT_MAX_AGE_MIN=90
VAULT_ENTRY_SOL=0.1
VAULT_STOP_PCT=25
VAULT_PARTIAL_AT_X=3
VAULT_PARTIAL_PCT=50
VAULT_TRAIL_PCT=35

# ── v1.0.4 celebrity-post rule ──
CELEB_POST_RULE=true
CELEB_MIN_FOLLOWERS=250000
CELEB_REQUIRE_VERIFIED=true
CELEB_CREATOR_MAX_PCT=1
CELEB_FANOUT_MIN=3
CELEB_CLUSTER_WINDOW_H=24
CELEB_MAX_POST_AGE_MIN=240
CELEB_ENTRY_SOL=0.1
CELEB_STOP_PCT=25
CELEB_PARTIAL_AT_X=3
CELEB_PARTIAL_PCT=50
CELEB_TRAIL_PCT=35
# ── v1.0.4 scale-in / trail / watchdog ──
SCALE_IN=true
SCALE_IN_FIRST_SOL=0.05
SCALE_IN_ADD_AFTER_S=300
SCALE_IN_LIQ_KEEP_PCT=80
SCALE_IN_MAX_DRAWDOWN_PCT=15
TRAIL_GIVEBACK_PTS=15
MONITOR_WATCHDOG=true
WATCHDOG_STALE_S=300
WATCHDOG_TICK_S=60
WATCHDOG_REALERT_S=1800

# ── v1.0.5 celeb_post watcher (optional; uses X_BEARER_TOKEN above) ──
CELEB_WATCH=true
CELEB_WATCH_HANDLES=
CELEB_WATCH_QUERY=
CELEB_WATCH_INTERVAL_S=180
SOLANA_RPC_URL=
